# Copie para .env (que já está no .gitignore) e preencha.

# --- Banco (Better Auth) ---
# Local: sobe com `pnpm db:up`. No Railway: use a DATABASE_URL PRIVADA
# (*.railway.internal), que não passa por TLS.
DATABASE_URL=postgres://bopoker:bopoker@localhost:5432/bopoker

# --- Better Auth ---
# Segredo de assinatura. Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL DO SERVIDOR (não do browser). Em dev é a porta 3001 mesmo com o Vite em
# 5173: cookies ignoram porta, então o cookie de localhost:3001 chega ao :5173.
# Em produção, o domínio do SERVIDOR (ex.: https://api-poker.exemplo.com).
BETTER_AUTH_URL=http://localhost:3001

# Origem do CLIENTE, separada por vírgula. Libera CORS com credenciais e entra
# nos trustedOrigins do Better Auth. Em produção: https://poker.exemplo.com
# CORS_ORIGIN=http://localhost:5173

# --- GitHub OAuth App ---
# Callbacks a registrar no app do GitHub:
#   http://localhost:3001/api/auth/callback/github
#   https://<dominio>/api/auth/callback/github
# O escopo user:email é obrigatório: sem ele, quem tem e-mail privado no GitHub
# volta do callback com email: null.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Somente desenvolvimento/teste ---
# Habilita sign-in por e-mail/senha para o smoke test conseguir um cookie real.
# NUNCA definir isto em produção: o servidor se recusa a subir se esta variável
# estiver ligada junto com NODE_ENV=production.
ENABLE_DEV_PASSWORD_AUTH=false

# --- Somente no serviço do CLIENTE, em build time (Vite) ---
# Origem do servidor quando ele está noutro subdomínio. Vazio em dev.
# Precisa ser subdomínio do MESMO domínio raiz do cliente — subdomínios de um
# mesmo domínio registrável são same-site e o cookie viaja; domínios distintos
# (dois *.up.railway.app, por exemplo) tornariam o cookie de terceiros, que o
# Safari bloqueia por padrão.
# VITE_SERVER_URL=https://api-poker.exemplo.com

# --- Opcionais (ver README) ---
# PORT=3001
# PLAYER_GRACE_MS=45000
# PLAYER_SWEEP_INTERVAL_MS=10000
